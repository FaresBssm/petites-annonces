# Modèle des variables de PRODUCTION (valeurs factices).
# Le vrai fichier deploy/.env.prod est généré par :  .\scripts\generer-env-prod.ps1 -Ip <ip> -DockerHub <compte>
# puis collé dans le secret GitHub PROD_ENV_FILE. Il n'est jamais commité.

PUBLIC_APP_URL=https://app.1-2-3-4.sslip.io
PUBLIC_API_URL=https://api.1-2-3-4.sslip.io
PUBLIC_AUTH_URL=https://auth.1-2-3-4.sslip.io

DOCKERHUB_NAMESPACE=compte-docker-hub
IMAGE_TAG=latest

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
ANNONCES_DB_USER=annonces
ANNONCES_DB_PASSWORD=change-me

KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

REALM_ALICE_PASSWORD=change-me
REALM_BOB_PASSWORD=change-me
REALM_MODO_PASSWORD=change-me
REALM_ADMIN_PASSWORD=change-me

# Paire RSA DÉDIÉE à la production (base64 sur une ligne, sans en-têtes PEM)
REALM_RSA_PRIVATE_KEY=change-me
REALM_PUBLIC_KEY=change-me

GATEWAY_SECRET=change-me
