# PetitesAnnonces — sites servis par le reverse proxy Nginx commun de la VM.
# Généré par ajouter-certificats.sh (__DOMAINE__ = <ip-avec-tirets>.sslip.io), copié dans reverse-proxy/conf.d/.
# Conforme au modèle _template.conf.example du serveur.

# HTTP : challenge ACME (Let's Encrypt) puis redirection vers HTTPS, pour les trois sous-domaines
server {
    listen 80;
    server_name app.__DOMAINE__ api.__DOMAINE__ auth.__DOMAINE__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Application Angular (Nginx du conteneur pa-frontend)
server {
    listen 443 ssl;
    http2 on;
    server_name app.__DOMAINE__;

    ssl_certificate     /etc/letsencrypt/live/app.__DOMAINE__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.__DOMAINE__/privkey.pem;
    include /etc/nginx/snippets/ssl-params.conf;

    location / {
        set $upstream http://pa-frontend:80;
        proxy_pass $upstream;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# API : gateway Kong (validation JWT, headers d'identité, rate limiting)
server {
    listen 443 ssl;
    http2 on;
    server_name api.__DOMAINE__;

    ssl_certificate     /etc/letsencrypt/live/api.__DOMAINE__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.__DOMAINE__/privkey.pem;
    include /etc/nginx/snippets/ssl-params.conf;

    location / {
        set $upstream http://pa-gateway:8000;
        proxy_pass $upstream;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # Transmis par Kong au backend : Location des 201 = https://api.../api/annonces/{id}
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  443;
    }
}

# Keycloak (Identity Provider)
server {
    listen 443 ssl;
    http2 on;
    server_name auth.__DOMAINE__;

    ssl_certificate     /etc/letsencrypt/live/auth.__DOMAINE__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/auth.__DOMAINE__/privkey.pem;
    include /etc/nginx/snippets/ssl-params.conf;

    location / {
        set $upstream http://pa-keycloak:8080;
        proxy_pass $upstream;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  443;
        # Les réponses de Keycloak portent de gros en-têtes (cookies de session)
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }
}
