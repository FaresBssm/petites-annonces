# Copier ce fichier en .env :  cp .env.example .env
# Valeurs FACTICES de développement local. Ne jamais commiter le fichier .env.

# --- PostgreSQL (superutilisateur de l'instance) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

# --- Base "keycloak" ---
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

# --- Base "annonces" (backend Spring Boot) ---
ANNONCES_DB_USER=annonces
ANNONCES_DB_PASSWORD=change-me-annonces-db

# --- Compte administrateur de la console Keycloak (realm master) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-kc-admin

# --- Utilisateurs de test du realm "annonces" ---
# Injectés dans keycloak/realm-annonces.json via les placeholders ${...} à l'import.
# fares, juba = USER ; mahdi = MODERATEUR ; admin = ADMIN
REALM_FARES_PASSWORD=fares-demo
REALM_JUBA_PASSWORD=juba-demo
REALM_MAHDI_PASSWORD=mahdi-demo
REALM_ADMIN_PASSWORD=admin-demo

# --- Paire de clés RSA FIXE du realm (signature des tokens, RS256) ---
# Clé privée PKCS#8 en base64 sur une ligne, injectée dans le realm à l'import.
# Clé de DÉMO dédiée à ce projet local : la clé publique correspondante est
# keycloak/realm-public-key.pem et sera recopiée dans kong/kong.yml.
# Changer cette clé => régénérer la clé publique et mettre à jour kong.yml.
REALM_RSA_PRIVATE_
