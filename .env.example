# Copier ce fichier en .env :  cp .env.example .env
# Valeurs FACTICES de développement local. Ne jamais commiter le fichier .env.
# (Les variables Keycloak/realm seront complétées aux étapes suivantes.)

# --- PostgreSQL (superutilisateur de l'instance) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

# --- Base "keycloak" ---
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

# --- Base "annonces" (backend Spring Boot) ---
ANNONCES_DB_USER=annonces
ANNONCES_DB_PASSWORD=change-me-annonces-db

# --- Compte administrateur de la console Keycloak (realm master) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-kc-admin
