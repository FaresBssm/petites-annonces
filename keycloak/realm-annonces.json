{
  "realm": "annonces",
  "displayName": "PetitesAnnonces",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "defaultSignatureAlgorithm": "RS256",
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "rsa-fixe-annonces",
        "providerId": "rsa",
        "subComponents": {},
        "config": {
          "priority": ["200"],
          "enabled": ["true"],
          "active": ["true"],
          "algorithm": ["RS256"],
          "keyUse": ["SIG"],
          "privateKey": ["${REALM_RSA_PRIVATE_KEY}"]
        }
      }
    ]
  },
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Consulter les annonces publiées, gérer ses propres annonces"
      },
      {
        "name": "MODERATEUR",
        "description": "USER + publier, rejeter, supprimer n'importe quelle annonce",
        "composite": true,
        "composites": { "realm": ["USER"] }
      },
      {
        "name": "ADMIN",
        "description": "MODERATEUR + gérer les catégories",
        "composite": true,
        "composites": { "realm": ["MODERATEUR"] }
      }
    ]
  },
  "clients": [
    {
      "clientId": "annonces-front",
      "name": "PetitesAnnonces - SPA Angular",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${PUBLIC_APP_URL}",
      "baseUrl": "/",
      "redirectUris": ["${PUBLIC_APP_URL}/*"],
      "webOrigins": ["${PUBLIC_APP_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${PUBLIC_APP_URL}/*",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "standard.token.exchange.enabled": "false"
      }
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@petites-annonces.local",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Utilisateur",
      "credentials": [{ "type": "password", "value": "${REALM_ALICE_PASSWORD}", "temporary": false }],
      "realmRoles": ["USER"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@petites-annonces.local",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Utilisateur",
      "credentials": [{ "type": "password", "value": "${REALM_BOB_PASSWORD}", "temporary": false }],
      "realmRoles": ["USER"]
    },
    {
      "username": "modo",
      "enabled": true,
      "email": "modo@petites-annonces.local",
      "emailVerified": true,
      "firstName": "Modo",
      "lastName": "Moderateur",
      "credentials": [{ "type": "password", "value": "${REALM_MODO_PASSWORD}", "temporary": false }],
      "realmRoles": ["MODERATEUR"]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@petites-annonces.local",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Annonces",
      "credentials": [{ "type": "password", "value": "${REALM_ADMIN_PASSWORD}", "temporary": false }],
      "realmRoles": ["ADMIN"]
    }
  ]
}
